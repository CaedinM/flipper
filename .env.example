# ===========================================
# Flipper Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database Configuration (Required)
DB_HOST=db
DB_PORT=5432
DB_NAME=flipper
DB_USER=flipper
DB_PASSWORD=your_secure_password_here

# Application Configuration
STREAMLIT_PORT=8501

# AI Features (Optional)
# These are only needed if you want to use the AI-powered release research features
TAVILY_API_KEY=
OPEN_AI_API_KEY=
